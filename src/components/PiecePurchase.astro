---
import type { Piece } from '../types';

interface Props {
    piece: Piece;
}

// Show live Stripe prices only when the site uses live Stripe keys, so dev can use test mode.
const isStripeLive = import.meta.env.STRIPE_PUBLISHABLE_KEY?.startsWith("pk_live_") ?? false;
const products = Astro.props.piece.products?.filter(product => product.prod === isStripeLive);

---

<h2>Purchase</h2>
{products && products?.length > 0 && <>
    <div class="mb-5">
        {products.map(product => (
            <div id="add-to-cart" data-product-id={product.priceId}></div>
        ))}    
    </div>
</>}
{(!products || products.length === 0) && <>
    <p>To purchase this work, please <a href="/contact">contact Alex</a> directly.</p>
</>}